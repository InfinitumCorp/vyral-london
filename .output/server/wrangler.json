{
  "compatibility_date": "2026-11-01",
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vyral-london",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "main": "index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "..\\public"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ]
}